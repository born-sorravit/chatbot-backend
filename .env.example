# ── Runtime ─────────────────────────────────────────
NODE_ENV=development
APP_ROLE=all
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:1234@localhost:5433/chatbots
DATABASE_SSL=false
DATABASE_LOGGING=false

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6380
REDIS_QUEUE_PREFIX=chatbots

# ── Auth ────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
CUSTOMER_SESSION_TTL=30d

# ── Observability / limits ──────────────────────────
LOG_LEVEL=debug
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# Strict on purpose: brute-force protection for /auth/login and
# /auth/refresh. Raise it locally (20+) if repeated manual testing locks
# you out — the in-memory window also clears on API restart.
AUTH_RATE_LIMIT_MAX=5
# Provider webhooks share a few source IPs — a floodgate, not a rate limit.
WEBHOOK_RATE_LIMIT_MAX=600

# ── LLM (chat) ──────────────────────────────────────
# 'stub' is a real provider that returns canned replies — it lets the whole
# AI pipeline run with no key and no spend. Switch to 'anthropic' and set
# LLM_API_KEY for real Claude responses; with 'anthropic' and no key the
# provider stays inactive and conversations hand off to a human.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_DEFAULT_MODEL=claude-opus-5
LLM_MAX_TOKENS=2048
LLM_DEFAULT_EFFORT=low
LLM_TIMEOUT_MS=60000

# ── AI behaviour ────────────────────────────────────
AI_MAX_CONTEXT_MESSAGES=20
AI_JOB_ATTEMPTS=3
AI_JOB_BACKOFF_MS=2000

# ══════════════════════════════════════════════════════
# Phase 4+ — listed for reference.
# See docs/ARCHITECTURE.md §10 for the full set.
# ══════════════════════════════════════════════════════
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSIONS=1024
# STORAGE_ENDPOINT=http://localhost:9000
